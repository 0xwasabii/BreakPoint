# Secrets and quick overrides. Everything else lives in breakpoint.toml
# (see breakpoint.example.toml). Environment variables always win over the file.

# ── API keys: set only the providers you use ──────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
# Local servers (llamacpp, lmstudio, vllm, ollama) need no key.
# Your own providers name their variable in breakpoint.toml: api_key_env = "MYLAB_API_KEY"

# ── Optional overrides (any breakpoint.toml key, upper-cased) ─────────────────
# TARGET=groq/openai/gpt-oss-120b
# ATTACKER=anthropic/claude-sonnet-4-5
# JUDGE=llamacpp/qwen
# CALL_BUDGET=200
# JUDGE_TEMPERATURE=0

# ── Older variables, still honoured ───────────────────────────────────────────
# ATTACKER_MODEL / JUDGE_MODEL   a Groq model id (used when ATTACKER / JUDGE are unset)
# OPENAI_BASE_URL                point the "openai" provider at a compatible server
# OLLAMA_URL / OLLAMA_MODEL      Ollama server location
